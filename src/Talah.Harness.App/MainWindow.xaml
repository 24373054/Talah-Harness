<Window
    x:Class="Talah.Harness.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Talah.Harness.App.Models"
    mc:Ignorable="d"
    Title="Talah Harness">

  <Grid x:Name="RootGrid" Background="{StaticResource CanvasBrush}" Loaded="RootGrid_Loaded">
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Extended title bar / kernel runway -->
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="296" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.ColumnSpan="3" Background="Transparent" />

        <StackPanel Grid.Column="0" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="11">
          <Image Width="28" Height="28" Source="Assets/app-256.png" Stretch="Uniform" />
          <StackPanel VerticalAlignment="Center" Spacing="-2">
            <TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="SemiBold" Text="TALAH HARNESS" Foreground="{StaticResource PrimaryTextBrush}" />
            <TextBlock Style="{StaticResource InstrumentLabelStyle}" FontSize="9" Text="TRACE LEDGER / 1.0" />
          </StackPanel>
        </StackPanel>

        <ItemsRepeater Grid.Column="1" Margin="12,0" ItemsSource="{x:Bind Kernels}">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="8" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="models:KernelDisplayState">
              <Button Padding="10,6" CornerRadius="7" Background="Transparent" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" AutomationProperties.Name="{x:Bind Name}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Ellipse Width="7" Height="7" Fill="{x:Bind IndicatorBrush}" VerticalAlignment="Center" />
                  <TextBlock FontFamily="Cascadia Mono" FontSize="11" Text="{x:Bind Name}" Foreground="{StaticResource PrimaryTextBrush}" />
                  <TextBlock FontSize="11" Text="{x:Bind Status, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <StackPanel Grid.Column="2" Margin="0,0,150,0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
          <Button Style="{StaticResource QuietIconButtonStyle}" Click="OpenDiagnostics_Click" ToolTipService.ToolTip="Diagnostics" AutomationProperties.Name="Open diagnostics">
            <FontIcon Glyph="&#xE9D9;" FontSize="16" />
          </Button>
          <Button Style="{StaticResource QuietIconButtonStyle}" Click="OpenSettings_Click" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Open settings">
            <FontIcon Glyph="&#xE713;" FontSize="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main three-pane workbench -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="296" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" MinWidth="480" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="344" />
      </Grid.ColumnDefinitions>

      <!-- Session ledger -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
        <Grid Padding="14,14,12,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
              <TextBlock Style="{StaticResource InstrumentLabelStyle}" Text="SESSION LEDGER" />
              <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Workspace runs" />
            </StackPanel>
            <Button Grid.Column="1" Width="38" Height="38" CornerRadius="8" Click="NewSession_Click" AutomationProperties.Name="Create a new session">
              <FontIcon Glyph="&#xE710;" FontSize="16" />
            </Button>
          </Grid>

          <AutoSuggestBox Grid.Row="1" Margin="0,14,0,10" PlaceholderText="Filter sessions" QueryIcon="Find" TextChanged="SessionFilter_TextChanged" AutomationProperties.Name="Filter sessions" />

          <ListView x:Name="SessionList" Grid.Row="2" ItemsSource="{x:Bind Sessions}" SelectionChanged="SessionList_SelectionChanged" SelectionMode="Single" IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:SessionDisplayState">
                <Grid Padding="10,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="3" CornerRadius="2" Background="{x:Bind AccentBrush}" />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="3">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryTextBrush}" />
                      <TextBlock Grid.Column="1" Text="{x:Bind UpdatedLabel}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                    <TextBlock Text="{x:Bind Preview}" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{x:Bind KernelName}" FontFamily="Cascadia Mono" FontSize="9" CharacterSpacing="60" Foreground="{x:Bind AccentBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <Button Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Click="ChooseWorkspace_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE838;" FontSize="15" />
              <StackPanel>
                <TextBlock Text="Workspace" FontWeight="SemiBold" />
                <TextBlock x:Name="WorkspacePathText" Text="Choose a folder" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="210" />
              </StackPanel>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource SubtleBorderBrush}" />

      <!-- Trace ledger -->
      <Grid Grid.Column="2" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="64" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="22,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock x:Name="ConversationTitleText" Style="{StaticResource SectionTitleStyle}" FontSize="20" Text="No active session" />
              <TextBlock x:Name="ConversationMetaText" Style="{StaticResource InstrumentLabelStyle}" Text="SELECT A KERNEL AND WORKSPACE TO BEGIN" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
              <Button Style="{StaticResource QuietIconButtonStyle}" Click="RefreshSession_Click" ToolTipService.ToolTip="Refresh session" AutomationProperties.Name="Refresh session">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
              </Button>
              <Button Style="{StaticResource QuietIconButtonStyle}" Click="OpenSessionMenu_Click" ToolTipService.ToolTip="Session actions" AutomationProperties.Name="Session actions">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <ScrollViewer x:Name="TraceScrollViewer" Padding="24,18,28,18">
            <ItemsRepeater ItemsSource="{x:Bind TraceItems}">
              <ItemsRepeater.Layout>
                <StackLayout Spacing="0" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="models:TraceDisplayState">
                  <Grid MinHeight="76">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="2" HorizontalAlignment="Center" Background="{StaticResource TraceRailBrush}" />
                    <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                      <Ellipse Fill="{StaticResource SurfaceBrush}" Stroke="{x:Bind AccentBrush}" StrokeThickness="2" />
                      <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind AccentBrush}" FontSize="12" />
                    </Grid>
                    <Border Grid.Column="1" Margin="8,4,0,14" Padding="14,11" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8">
                      <StackPanel Spacing="6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{x:Bind KindLabel}" FontFamily="Cascadia Mono" FontSize="10" CharacterSpacing="70" Foreground="{x:Bind AccentBrush}" />
                          <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{x:Bind Title}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                          <TextBlock Grid.Column="2" Text="{x:Bind Timestamp}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource PrimaryTextBrush}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </ScrollViewer>

          <Grid x:Name="EmptySessionPanel" Padding="52,34" Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image MaxWidth="620" MaxHeight="430" HorizontalAlignment="Center" VerticalAlignment="Center" Source="Assets/Brand/empty-session-ledger.png" Stretch="Uniform" Opacity="0.92" />
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,16,0,20" Spacing="8">
              <TextBlock HorizontalAlignment="Center" FontFamily="Bahnschrift SemiCondensed" FontSize="28" FontWeight="SemiBold" Text="The ledger is ready" Foreground="{StaticResource PrimaryTextBrush}" />
              <TextBlock MaxWidth="520" TextAlignment="Center" TextWrapping="Wrap" Text="Choose a workspace and a kernel. Every prompt, approval, command, file change, and result will remain on one inspectable trace." Foreground="{StaticResource SecondaryTextBrush}" />
              <Button Margin="0,8,0,0" HorizontalAlignment="Center" Click="NewSession_Click" Content="Start a session" />
            </StackPanel>
          </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="18,8,18,16" Padding="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="PromptTextBox" MinHeight="68" MaxHeight="220" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Describe the change, investigation, or command…" BorderThickness="0" Background="Transparent" IsEnabled="False" KeyDown="PromptTextBox_KeyDown" AutomationProperties.Name="Agent prompt" />
            <Grid Grid.Row="1" Margin="2,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource QuietIconButtonStyle}" Click="AttachFiles_Click" IsEnabled="False" ToolTipService.ToolTip="Attach files" AutomationProperties.Name="Attach files">
                  <FontIcon Glyph="&#xE723;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource QuietIconButtonStyle}" Click="ChooseWorkspace_Click" ToolTipService.ToolTip="Change workspace" AutomationProperties.Name="Change workspace">
                  <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Cascadia Mono" FontSize="10" Text="NO ACTIVE KERNEL" Foreground="{StaticResource SecondaryTextBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="StopButton" Visibility="Collapsed" Click="StopTurn_Click" Content="Stop" />
                <Button x:Name="SendButton" IsEnabled="False" Click="SendPrompt_Click" Content="Run" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="3" Background="{StaticResource SubtleBorderBrush}" />

      <!-- Inspector -->
      <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}">
        <ScrollViewer Padding="16,14,14,18">
          <StackPanel Spacing="16">
            <StackPanel Spacing="2">
              <TextBlock Style="{StaticResource InstrumentLabelStyle}" Text="INSPECTOR" />
              <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Run context" />
            </StackPanel>

            <Border Padding="12" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="10">
                <TextBlock Text="Kernel" FontWeight="SemiBold" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="InspectorKernelName" Text="None selected" Foreground="{StaticResource SecondaryTextBrush}" />
                  <Border Grid.Column="1" Padding="7,3" CornerRadius="10" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="InspectorKernelState" FontFamily="Cascadia Mono" FontSize="9" Text="OFFLINE" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Spacing="8">
              <TextBlock Text="Security boundary" FontWeight="SemiBold" />
              <InfoBar x:Name="SecurityInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="No kernel selected" Message="The selected kernel's actual enforcement owner, writable roots, process limits, and network policy appear here." />
            </StackPanel>

            <StackPanel Spacing="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Workspace impact" FontWeight="SemiBold" />
                <Button Grid.Column="1" Style="{StaticResource QuietIconButtonStyle}" IsEnabled="False" AutomationProperties.Name="Refresh workspace impact">
                  <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
              </Grid>
              <Border Padding="13,18" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                  <FontIcon Glyph="&#xE8A5;" FontSize="22" Foreground="{StaticResource SecondaryTextBrush}" />
                  <TextBlock Text="No file changes" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Capabilities" FontWeight="SemiBold" />
              <ItemsControl x:Name="CapabilityList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource VerifiedGreenBrush}" />
                      <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding}" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Expander Header="Diagnostics" IsExpanded="False">
              <TextBlock x:Name="DiagnosticsText" Margin="0,8,0,0" FontFamily="Cascadia Mono" FontSize="10" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="Runtime discovery has not completed." Foreground="{StaticResource SecondaryTextBrush}" />
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <InfoBar x:Name="TransientInfoBar" Grid.Row="1" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="680" IsOpen="False" IsClosable="True" />

    <!-- First-run overlay -->
    <Grid x:Name="OnboardingOverlay" Grid.RowSpan="2" Background="#E6080645" Visibility="Collapsed">
      <Border MaxWidth="1120" MaxHeight="720" Margin="36" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SurfaceBrush}" BorderBrush="#5562C7E5" BorderThickness="1" CornerRadius="14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0" Source="Assets/Brand/onboarding-kernel-traces.png" Stretch="UniformToFill" />
          <StackPanel Grid.Column="1" Padding="38,34" VerticalAlignment="Center" Spacing="17">
            <TextBlock Style="{StaticResource InstrumentLabelStyle}" Text="TALAH HARNESS / FIRST RUN" />
            <TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="42" FontWeight="SemiBold" Text="Three kernels. One accountable trace." TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
            <TextBlock FontSize="15" LineHeight="23" Text="Choose Codex, OpenCode, or TLAH for each session. The Harness keeps the workspace, approvals, process lifecycle, and durable audit trail visible without pretending the engines have identical security guarantees." TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="8" Height="8" Fill="{StaticResource ChainCyanBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Official subscription login and API keys, isolated per profile" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="8" Height="8" Fill="{StaticResource EvidenceGoldBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Every permission remains attached to its native kernel meaning" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="8" Height="8" Fill="{StaticResource VerifiedGreenBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Interrupted sessions remain recoverable and inspectable" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <CheckBox x:Name="TelemetryConsentCheckBox" Content="Share anonymous reliability diagnostics" IsChecked="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Click="ReviewSecurity_Click" Content="Review security" />
              <Button Click="CompleteOnboarding_Click" Content="Set up kernels" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

