<Application
    x:Class="Talah.Harness.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="CanvasColor">#FFF4F7FA</Color>
          <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
          <Color x:Key="SurfaceRaisedColor">#FFF8FAFC</Color>
          <Color x:Key="BorderColor">#1F162230</Color>
          <Color x:Key="PrimaryTextColor">#FF162230</Color>
          <Color x:Key="SecondaryTextColor">#B3162230</Color>
          <Color x:Key="RailColor">#3862C7E5</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="CanvasColor">#FF0B1220</Color>
          <Color x:Key="SurfaceColor">#FF111B2A</Color>
          <Color x:Key="SurfaceRaisedColor">#FF162230</Color>
          <Color x:Key="BorderColor">#2FF4F7FA</Color>
          <Color x:Key="PrimaryTextColor">#FFF4F7FA</Color>
          <Color x:Key="SecondaryTextColor">#BDF4F7FA</Color>
          <Color x:Key="RailColor">#6662C7E5</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <Color x:Key="CanvasColor">#FF000000</Color>
          <Color x:Key="SurfaceColor">#FF000000</Color>
          <Color x:Key="SurfaceRaisedColor">#FF000000</Color>
          <Color x:Key="BorderColor">#FFFFFFFF</Color>
          <Color x:Key="PrimaryTextColor">#FFFFFFFF</Color>
          <Color x:Key="SecondaryTextColor">#FFFFFFFF</Color>
          <Color x:Key="RailColor">#FFFFFF00</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource CanvasColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="SubtleBorderBrush" Color="{ThemeResource BorderColor}" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource PrimaryTextColor}" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SecondaryTextColor}" />
      <SolidColorBrush x:Key="TraceRailBrush" Color="{ThemeResource RailColor}" />
      <SolidColorBrush x:Key="ChainCyanBrush" Color="#FF62C7E5" />
      <SolidColorBrush x:Key="LedgerBlueBrush" Color="#FF115A82" />
      <SolidColorBrush x:Key="EvidenceGoldBrush" Color="#FFD8B956" />
      <SolidColorBrush x:Key="VerifiedGreenBrush" Color="#FF3FA77C" />
      <SolidColorBrush x:Key="RiskRedBrush" Color="#FFD9514E" />
      <SolidColorBrush x:Key="KeNavyBrush" Color="#FF080645" />

      <Style x:Key="InstrumentLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      </Style>

      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      </Style>

      <Style x:Key="QuietIconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
